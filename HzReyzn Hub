local function scriptButton(parent, name, url, order)
    local row = button(
        parent, "", UDim2.fromOffset(0, 0),
        UDim2.new(1, 0, 0, 94)
    )
    row.Name = name
    row.LayoutOrder = order
    row.AutoButtonColor = false
    row.BackgroundTransparency = 0
    local cardGradient = make("UIGradient", row, {Rotation = 15})
    local cardStroke = gradientBorder(row, 1.6, 0.15)
    local stripe = make("Frame", row, {
        Position = UDim2.fromOffset(0, 15),
        Size = UDim2.new(0, 4, 1, -30),
        BackgroundColor3 = pink, BorderSizePixel = 0,
    })
    round(stripe, 2)
    local card = {
        row = row, gradient = cardGradient, stripe = stripe,
        stroke = cardStroke, hovered = false,
    }
    table.insert(executableCards, card)
    connect(row.MouseEnter, function()
        card.hovered = true
        cardStroke.Thickness = 2.4
        if paintColors then paintColors(colorClock) end
    end)
    connect(row.MouseLeave, function()
        card.hovered = false
        cardStroke.Thickness = 1.6
        if paintColors then paintColors(colorClock) end
    end)

    local titleLabel = label(
        row, name, UDim2.fromOffset(20, 10),
        UDim2.new(1, -40, 0, 42), 15
    )
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextWrapped = true

    local stateLabel = label(
        row, "EXECUTE  •  Tap to launch",
        UDim2.fromOffset(20, 61),
        UDim2.new(1, -40, 0, 20),
        11, muted
    )

    local busy = false

    local function show(text, color)
        if destroyed or not row.Parent then return end
        stateLabel.Text = text
        stateLabel.TextColor3 = color or muted
    end

    connect(row.Activated, function()
        if busy or destroyed then return end
        busy = true
        show("Loading...", accentColor)

        task.spawn(function()
            local ok, err = pcall(function()
                if type(loadstring) ~= "function" then
                    error("loadstring is unavailable in this environment.")
                end

                local source = game:HttpGet(url)
                if destroyed then return end

                if type(source) ~= "string" or source:match("^%s*$") then
                    error("The URL returned no script.")
                end

                local executable, compileError = loadstring(source)
                if not executable then
                    error(compileError or "Invalid Lua source.")
                end

                if destroyed then return end
                show("Starting...", accentColor)
                executable()
            end)

            if destroyed then return end

            if ok then
                show(
                    "Executed • Tap to run again",
                    Color3.fromRGB(158, 219, 185)
                )
            else
                show(
                    "Could not execute • Tap to retry",
                    Color3.fromRGB(246, 151, 160)
                )
                warn("[HzReyzn Hub / " .. name .. "] " .. tostring(err))
            end

            task.delay(0.75, function()
                busy = false
            end)
        end)
    end)
end

