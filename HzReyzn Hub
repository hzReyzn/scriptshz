-- Antifling integrado; comienza apagado.

do
    local CONFIG = {
        MaxHorizontalSpeed = 140,
        MaxUpwardSpeed = 180,
        MaxAngularSpeed = 65,
        PlayerRadius = 65,
        ScanInterval = 0.25,
        SafePositionAge = 1.5,
        MaxRecoveryDistance = 60,
    }

    local character, humanoid, root
    local safeCFrame, safeTime
    local recoveryUntil = 0
    local scanClock = 0
    local pairsByPart = {}

    local constraintFolder = make("Folder", workspace, {
        Name = "HZAntiflingLocalConstraints"
    })

    local function clearConstraints()
        constraintFolder:ClearAllChildren()
        table.clear(pairsByPart)
    end

    local function resetRecovery()
        safeCFrame, safeTime = nil, nil
        recoveryUntil = 0
    end

    cleanupProtection = function()
        antiflingEnabled = false
        constraintFolder:Destroy()
        table.clear(pairsByPart)
        resetRecovery()
    end

    local function setEnabled(value)
        if destroyed then return end

        antiflingEnabled = value == true
        clearConstraints()
        resetRecovery()
        scanClock = CONFIG.ScanInterval
        refreshProtection()
    end

    connect(antiflingButton.Activated, function()
        setEnabled(not antiflingEnabled)
    end)

    local function bindCharacter(newCharacter)
        character = newCharacter
        humanoid, root = nil, nil
        clearConstraints()
        resetRecovery()
        scanClock = CONFIG.ScanInterval
    end

    connect(player.CharacterAdded, bindCharacter)

    connect(player.CharacterRemoving, function(removing)
        if character == removing then
            bindCharacter(nil)
        end
    end)

    bindCharacter(player.Character)

    local function updateConstraints()
        local localParts, otherParts = {}, {}

        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then localParts[part] = true end
        end

        for _, other in ipairs(Players:GetPlayers()) do
            local model = other.Character
            local otherRoot = model and model:FindFirstChild("HumanoidRootPart")

            if other ~= player and otherRoot
                and (otherRoot.Position - root.Position).Magnitude
                    <= CONFIG.PlayerRadius then

                for _, part in ipairs(model:GetDescendants()) do
                    if part:IsA("BasePart") then otherParts[part] = true end
                end
            end
        end

        for localPart, mapping in pairs(pairsByPart) do
            for otherPart, constraint in pairs(mapping) do
                if not localParts[localPart] or not otherParts[otherPart] then
                    constraint:Destroy()
                    mapping[otherPart] = nil
                end
            end

            if not localParts[localPart] then
                pairsByPart[localPart] = nil
            end
        end

        for localPart in pairs(localParts) do
            local mapping = pairsByPart[localPart] or {}
            pairsByPart[localPart] = mapping

            for otherPart in pairs(otherParts) do
                if not mapping[otherPart] or not mapping[otherPart].Parent then
                    mapping[otherPart] = make(
                        "NoCollisionConstraint", constraintFolder, {
                            Part0 = localPart,
                            Part1 = otherPart,
                        }
                    )
                end
            end
        end
    end

    local function protect()
        if not antiflingEnabled or not root or not root.Parent
            or not humanoid or humanoid.Health <= 0 then
            return
        end

        if humanoid.SeatPart or root.Anchored then
            resetRecovery()
            return
        end

        local velocity = root.AssemblyLinearVelocity
        local horizontal = Vector3.new(velocity.X, 0, velocity.Z).Magnitude

        local extreme = horizontal > math.max(CONFIG.MaxHorizontalSpeed, ndsSpeedLimit * 1.5 + 20)
            or velocity.Y > CONFIG.MaxUpwardSpeed
            or root.AssemblyAngularVelocity.Magnitude > CONFIG.MaxAngularSpeed

        local now = os.clock()

        if extreme then
            if safeCFrame and now - safeTime <= CONFIG.SafePositionAge
                and (root.Position - safeCFrame.Position).Magnitude
                    <= CONFIG.MaxRecoveryDistance then
                root.CFrame = safeCFrame
            end

            root.AssemblyLinearVelocity = Vector3.new(
                0, math.clamp(velocity.Y, -60, 0), 0
            )
            root.AssemblyAngularVelocity = Vector3.zero

            resetRecovery()
            recoveryUntil = now + 0.35

        elseif now >= recoveryUntil
            and humanoid.FloorMaterial ~= Enum.Material.Air
            and horizontal < CONFIG.MaxHorizontalSpeed * 0.5
            and math.abs(velocity.Y) < 15
            and root.AssemblyAngularVelocity.Magnitude < 8 then

            safeCFrame, safeTime = root.CFrame, now
        end
    end

    connect(RunService.PreSimulation, function(dt)
        if not antiflingEnabled or not character or not character.Parent then
            return
        end

        humanoid = character:FindFirstChildOfClass("Humanoid")
        root = character:FindFirstChild("HumanoidRootPart")

        if not humanoid or not root or humanoid.Health <= 0 then
            if next(pairsByPart) then clearConstraints() end
            resetRecovery()
            return
        end

        scanClock = scanClock + dt

        if scanClock >= CONFIG.ScanInterval then
            scanClock = 0
            updateConstraints()
        end

        protect()
    end)

    connect(RunService.PostSimulation, protect)
    setEnabled(false)
end

-- NDS controls: no map-wide scans; defaults are OFF.
do
    local flags = {noclip=false, jump=false, float=false, gravity=false, nofall=false, speed=false, water=false}
    local values = {gravity=math.floor(workspace.Gravity+0.5), speed=16}
    local controls = {}
    local char, hum, root
    local speedHum, oldSpeed, oldGravity
    local jumpConnection
    local characterConnections = {}
    local pendingFloor = false
    local floorRising = false
    local savedRoot, savedVelocity
    local function restoreVelocity()
        if savedRoot and savedRoot.Parent then savedRoot.AssemblyLinearVelocity = savedVelocity end
        savedRoot, savedVelocity = nil, nil
    end
    local function armFloor()
        if flags.float and not pendingFloor then
            pendingFloor = true
            floorRising = false
        end
    end
    local activeFloor
    local lastJump = 0
    local floatFolder = make("Folder", workspace, {Name="HZLocalFloatFloors"})
    local clipFolder = make("Folder", workspace, {Name="HZLocalWallConstraints"})
    local floorParts = {}
    local wallPairs = {}
    local overlap = OverlapParams.new()
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    overlap.MaxParts = 48
    local ray = RaycastParams.new()
    ray.FilterType = Enum.RaycastFilterType.Exclude
    ray.RespectCanCollide = true


    local waterObject, waterPad, waterLastY, waterLastSource
    local waterGroundParams=RaycastParams.new()
    waterGroundParams.FilterType=Enum.RaycastFilterType.Exclude
    waterGroundParams.IgnoreWater=true
    waterGroundParams.RespectCanCollide=true
    local function clearWater()
        if waterPad then waterPad:Destroy();waterPad=nil end
        waterLastY,waterLastSource=nil,nil
    end
    local waterCandidates, nextWaterScan = {}, 0
    local function waterSurfaceAt(position)
        -- Scan only while enabled; read cached surfaces each physics step.
        if os.clock() >= nextWaterScan then
            nextWaterScan=os.clock()+1
            waterCandidates={}
            for _,obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") then
                    local n=obj.Name:lower()
                    local parentName=obj.Parent and obj.Parent.Name:lower() or ""
                    local named=n:find("flood",1,true) or n=="water" or n=="waterlevel"
                        or n=="floodwater" or parentName:find("flood",1,true)
                    local watery=obj.Material==Enum.Material.Water
                    if n~="floodlevel" and (n=="waterlevel" or ((named or watery) and obj.Size.X>=32 and obj.Size.Z>=32)) then
                        table.insert(waterCandidates,obj)
                    end
                end
            end
        end
        waterObject=workspace:FindFirstChild("WaterLevel")
        local bestY,bestSource
        if waterObject and (waterObject:IsA("NumberValue") or waterObject:IsA("IntValue")) then
            bestY,bestSource=waterObject.Value,waterObject
        end
        for _,water in ipairs(waterCandidates) do
            if water:IsDescendantOf(workspace) then
                local mesh=water:FindFirstChildWhichIsA("DataModelMesh")
                local cf=water.CFrame
                local origin=cf.Position
                local localY=water.Size.Y*0.5
                local sx,sz=water.Size.X,water.Size.Z
                if mesh then
                    origin=cf:PointToWorldSpace(mesh.Offset)
                    sx=sx*math.abs(mesh.Scale.X);sz=sz*math.abs(mesh.Scale.Z)
                    if mesh:IsA("BlockMesh") or (mesh:IsA("SpecialMesh") and mesh.MeshType==Enum.MeshType.Brick) then
                        localY=water.Size.Y*math.abs(mesh.Scale.Y)*0.5
                    else localY=0 end
                end
                local normal=cf.UpVector
                local relative=cf:VectorToObjectSpace(position-origin)
                local inside=water==waterObject or (math.abs(relative.X)<=sx*0.5 and math.abs(relative.Z)<=sz*0.5)
                if inside and normal.Y>=0.95 then
                    local top=origin+normal*localY
                    local y=top.Y-(normal.X*(position.X-top.X)+normal.Z*(position.Z-top.Z))/normal.Y
                    if not bestY or y>bestY then bestY,bestSource=y,water end
                end
            end
        end
        -- FloodLevel is a height marker, not the full rendered water footprint.
        -- Read the live instance every frame so round replacements are handled.
        local structure=workspace:FindFirstChild("Structure")
        local flood=structure and structure:FindFirstChild("FloodLevel")
        if flood then
            local floodY
            if flood:IsA("BasePart") then
                floodY=flood.Position.Y
            elseif flood:IsA("NumberValue") or flood:IsA("IntValue") then
                floodY=flood.Value
            end
            if floodY and (not bestY or floodY>bestY) then
                bestY,bestSource=floodY,flood
            end
        end
        return bestY,bestSource
    end

    local function updateWater()
        if not flags.water then return end
        local y,source=waterSurfaceAt(root.Position)
        if not y then clearWater();return end
        if not waterPad then
            waterPad=make("Part",workspace,{
                Name="HZHubWaterSupport",Size=Vector3.new(16,0.5,16),
                Anchored=true,Transparency=1,CanCollide=false,CanTouch=false,
                CanQuery=false,CastShadow=false,
            })
        end
        local targetY=y -- Fixed separation: 0 studs.
        local leg=char:FindFirstChild("Left Leg")
        local feet=root.Position.Y-(hum.HipHeight+root.Size.Y*0.5+(leg and leg.Size.Y or 0))
        local grounded=waterPad.CanCollide and waterLastY and math.abs(feet-waterLastY)<0.8
            and not hum.Jump and hum:GetState()~=Enum.HumanoidStateType.Jumping
            and hum:GetState()~=Enum.HumanoidStateType.Freefall
        if grounded then
            local delta=targetY-waterLastY
            if math.abs(delta)<=12 then
                waterGroundParams.FilterDescendantsInstances={char,waterPad}
                local ground=workspace:Raycast(root.Position,
                    Vector3.new(0,-(root.Position.Y-feet+0.8),0),waterGroundParams)
                if not ground then
                    root.CFrame=root.CFrame+Vector3.new(0,delta,0)
                    feet=feet+delta
                end
            end
        end
        waterPad.CFrame=CFrame.new(root.Position.X,targetY-waterPad.Size.Y*0.5,root.Position.Z)
        waterPad.CanCollide=feet>=targetY-0.7
        waterLastY,waterLastSource=targetY,source
    end

    local function clearFloors()
        pendingFloor = false
        floorRising = false
        activeFloor = nil
        floatFolder:ClearAllChildren()
        table.clear(floorParts)
    end
    local function clearWalls()
        clipFolder:ClearAllChildren()
        table.clear(wallPairs)
    end
    local function restoreSpeed()
        if speedHum and speedHum.Parent and oldSpeed ~= nil then
            speedHum.WalkSpeed = oldSpeed
        end
        speedHum, oldSpeed = nil, nil
        ndsSpeedLimit = 0
    end
    local function applySpeed()
        if not hum or hum.Health <= 0 then return end
        if speedHum ~= hum then
            restoreSpeed()
            speedHum, oldSpeed = hum, hum.WalkSpeed
        end
        hum.WalkSpeed = values.speed
        ndsSpeedLimit = values.speed
    end
    local function applyValue(key)
        if key == "gravity" and flags.gravity then workspace.Gravity = values.gravity end
        if key == "speed" and flags.speed then applySpeed() end
    end
    local function setFlag(key, on)
        flags[key] = on
        if key == "gravity" then
            if on then oldGravity = workspace.Gravity; applyValue(key)
            elseif oldGravity ~= nil then workspace.Gravity = oldGravity; oldGravity = nil end
        elseif key == "speed" then
            if on then applySpeed() else restoreSpeed() end
        elseif key == "noclip" then clearWalls()
        elseif key == "water" then
            nextWaterScan=0
            if not on then clearWater();waterCandidates={} end
        elseif key == "nofall" then
            if not on then restoreVelocity() end
        elseif key == "float" then
            if not on then clearFloors() end
        end
        refreshNDS()
    end
    local function numericValue(text, fallback, low, high)
        local n = tonumber((tostring(text):gsub(",", ".")))
        if not n or n ~= n or n == math.huge or n == -math.huge then return fallback end
        return math.clamp(n, low, high)
    end
    local function addControl(name, key, order, numeric)
        local height = numeric and 100 or 56
        local row = make("Frame", ndsScroll, {
            Name=key, LayoutOrder=order, Size=UDim2.new(1,0,0,height),
            BackgroundColor3=panelColor, BorderSizePixel=0,
        })
        round(row,12)
        gradientBorder(row,1.3,0.22)
        local heading = label(row,name,UDim2.fromOffset(14,0),UDim2.new(1,-98,0,56),15,white)
        heading.Font=Enum.Font.GothamBold
        local toggle=button(row,"OFF",UDim2.new(1,-73,0,11),UDim2.fromOffset(60,34))
        toggle.TextSize=12
        local entry={row=row,toggle=toggle,key=key}
        controls[#controls+1]=entry
        connect(toggle.Activated,function() setFlag(key,not flags[key]) end)
        if numeric then
            local minus=button(row,"−",UDim2.fromOffset(14,57),UDim2.fromOffset(32,32))
            local field=make("TextBox",row,{
                Position=UDim2.fromOffset(54,57),Size=UDim2.new(1,-108,0,32),
                Text=key=="gravity" and string.format("%d",values[key]) or tostring(values[key]),ClearTextOnFocus=false,
                BackgroundColor3=dark,TextColor3=white,BorderSizePixel=0,
                Font=Enum.Font.GothamMedium,TextSize=14,
            })
            round(field,7)
            local plus=button(row,"+",UDim2.new(1,-46,0,57),UDim2.fromOffset(32,32))
            entry.field=field;entry.minus=minus;entry.plus=plus
            local function commit(n)
                values[key]=numericValue(n,values[key],numeric.min,numeric.max)
                if key=="gravity" then values[key]=math.floor(values[key]+0.5) end
                field.Text=string.format("%.2f",values[key]):gsub("0+$",""):gsub("%.$","")
                applyValue(key)
            end
            connect(field.FocusLost,function() commit(field.Text) end)
            connect(minus.Activated,function() commit(values[key]-numeric.step) end)
            connect(plus.Activated,function() commit(values[key]+numeric.step) end)
        end
    end
    refreshNDS=function()
        for _,entry in ipairs(controls) do
            entry.row.BackgroundColor3=panelColor
            entry.toggle.Text=flags[entry.key] and "ON" or "OFF"
            entry.toggle.BackgroundColor3=flags[entry.key] and selectedBackground or idleTabColor
            entry.toggle.TextColor3=flags[entry.key] and accentColor or muted
            if entry.field then
                entry.field.BackgroundColor3=dark
                entry.minus.BackgroundColor3=idleTabColor;entry.plus.BackgroundColor3=idleTabColor
                entry.minus.TextColor3=accentColor;entry.plus.TextColor3=accentColor
            end
        end
    end
    addControl("WalkOnWater","water",1.5)
    addControl("No collision | Noclip","noclip",2)
    addControl("Inf Jump","jump",3)
    addControl("Float","float",4)
    addControl("Gravity","gravity",5,{step=5,min=0,max=1000})
    addControl("No FallDamage","nofall",0)
    addControl("Speed","speed",7,{step=1,min=0,max=300})
    refreshNDS()

    local function bind(model)
        restoreVelocity()
        if jumpConnection then jumpConnection:Disconnect();jumpConnection=nil end
        for _,c in ipairs(characterConnections) do c:Disconnect() end
        table.clear(characterConnections)
        restoreSpeed();clearWalls();clearFloors();clearWater()
        char=model;hum=nil;root=nil;lastJump=0
    end
    local function resolveCharacter()
        if not char or not char.Parent then return false end
        local h=char:FindFirstChildOfClass("Humanoid")
        root=char:FindFirstChild("HumanoidRootPart")
        if h ~= hum then
            if jumpConnection then jumpConnection:Disconnect();jumpConnection=nil end
            restoreSpeed()
            hum=h
            if hum then
                jumpConnection=hum.StateChanged:Connect(function(_,state)
                    if state==Enum.HumanoidStateType.Jumping then armFloor() end
                    if state==Enum.HumanoidStateType.Dead then clearWalls();clearFloors();restoreSpeed() end
                end)
            end
        end
        return hum and root and hum.Health>0 and not hum.SeatPart and not root.Anchored
    end
    connect(player.CharacterAdded,bind)
    connect(player.CharacterRemoving,function(model) if char==model then bind(nil) end end)
    bind(player.Character)
    connect(UIS.JumpRequest,function()
        if destroyed or UIS:GetFocusedTextBox() or not resolveCharacter() then return end
        armFloor()
        if not flags.jump then return end
        local now=os.clock()
        if now-lastJump<0.18 then return end
        lastJump=now
        local velocity=hum.UseJumpPower and hum.JumpPower
            or math.sqrt(2*math.max(workspace.Gravity,1)*hum.JumpHeight)
        local v=root.AssemblyLinearVelocity
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        root.AssemblyLinearVelocity=Vector3.new(v.X,math.max(velocity,35),v.Z)
        armFloor()
    end)
    local function floorDistance()
        local leg=char:FindFirstChild("Left Leg")
        return hum.HipHeight+root.Size.Y*0.5+(leg and leg.Size.Y or 0)
    end
    local function addFloor()
        if not activeFloor or not activeFloor.Parent then
            activeFloor=make("Part",floatFolder,{
                Name="HZFloatFloor",Size=Vector3.new(18,0.35,18),
                Anchored=true,Transparency=1,CanCollide=true,CanTouch=false,CanQuery=true,
            })
        end
        activeFloor.CFrame=CFrame.new(root.Position-Vector3.new(0,floorDistance()+0.25,0))
    end
    local function isCharacter(part)
        local parent=part.Parent
        while parent and parent~=workspace do
            if parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") then return true end
            parent=parent.Parent
        end
        return false
    end
    local function scanWalls()
        overlap.FilterDescendantsInstances={char,floatFolder,clipFolder,waterPad}
        ray.FilterDescendantsInstances={char,floatFolder,clipFolder,waterPad}
        local protected={}
        local reach=floorDistance()+3
        for _,offset in ipairs({Vector3.zero,Vector3.new(1,0,0),Vector3.new(-1,0,0),Vector3.new(0,0,1),Vector3.new(0,0,-1)}) do
            for _,sign in ipairs({-1,1}) do
                local hit=workspace:Raycast(root.Position+offset,Vector3.new(0,sign*reach,0),ray)
                if hit and math.abs(hit.Normal.Y)>0.45 then protected[hit.Instance]=true end
            end
        end
        local nearby=workspace:GetPartBoundsInBox(root.CFrame,Vector3.new(12,9,12),overlap)
        local wanted,body={},{}
        for _,p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and not p:FindFirstAncestorOfClass("Accessory") and not p:FindFirstAncestorOfClass("Tool") then body[p]=true end
        end
        local count=0
        for _,p in ipairs(nearby) do
            if count<16 and p.CanCollide and not protected[p] and not isCharacter(p) then
                -- Keep horizontal slabs, ramps, terrain, floors and ceilings solid.
                local axes={p.CFrame.RightVector,p.CFrame.UpVector,p.CFrame.LookVector}
                local dimensions={p.Size.X,p.Size.Y,p.Size.Z}
                local thin=1
                for i=2,3 do if dimensions[i]<dimensions[thin] then thin=i end end
                if math.abs(axes[thin].Y)<0.45 and not p:IsA("Terrain") then
                    wanted[p]=true;count=count+1
                end
            end
        end
        for wall,mapping in pairs(wallPairs) do
            for part,constraint in pairs(mapping) do
                if not wanted[wall] or not body[part] or not wall.Parent then
                    constraint:Destroy();mapping[part]=nil
                end
            end
            if not wanted[wall] or not wall.Parent then wallPairs[wall]=nil end
        end
        for wall in pairs(wanted) do
            local mapping=wallPairs[wall] or {};wallPairs[wall]=mapping
            for part in pairs(body) do
                if not mapping[part] then
                    mapping[part]=make("NoCollisionConstraint",clipFolder,{Part0=part,Part1=wall})
                end
            end
        end
    end
    local scanClock,speedClock=0,0
    connect(RunService.PreSimulation,function(dt)
        restoreVelocity()
        if destroyed then return end
        if not resolveCharacter() then
            clearWater()
            if next(wallPairs) then clearWalls() end
            pendingFloor=false
            return
        end
        updateWater()
        speedClock=speedClock+dt
        if flags.speed and speedClock>=0.15 then speedClock=0;applySpeed() end
        if flags.float and root.AssemblyLinearVelocity.Y > 1 then
            armFloor()
            floorRising = true
        end
        if flags.float and activeFloor and activeFloor.Parent then
            activeFloor.CFrame=CFrame.new(root.Position.X,activeFloor.Position.Y,root.Position.Z)
        end
        if flags.float and pendingFloor and floorRising and root.AssemblyLinearVelocity.Y<=1 then
            pendingFloor=false;floorRising=false;addFloor()
        end
        if flags.noclip then
            scanClock=scanClock+dt
            if scanClock>=0.12 then scanClock=0;scanWalls() end
        end
    end)
    -- Match the tested Heartbeat/render method without yielding callbacks.
    connect(RunService.Heartbeat,function()
        restoreVelocity()
        if destroyed or not flags.nofall or not resolveCharacter() then return end
        savedRoot, savedVelocity = root, root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.zero
    end)
    connect(RunService.RenderStepped,restoreVelocity)
    cleanupNDS=function()
        restoreVelocity()
        for key in pairs(flags) do flags[key]=false end
        if jumpConnection then jumpConnection:Disconnect();jumpConnection=nil end
        for _,c in ipairs(characterConnections) do c:Disconnect() end
        restoreSpeed()
        if oldGravity~=nil then workspace.Gravity=oldGravity;oldGravity=nil end
        clearWalls();clearFloors();clearWater()
        clipFolder:Destroy();floatFolder:Destroy()
    end
end

