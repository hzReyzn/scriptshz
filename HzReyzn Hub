local windowAnimating = false
local minimized = false
local launcherPlaced = false

local function clampLauncher(x, y)
    local bounds = surface.AbsoluteSize

    launcher.Position = UDim2.fromOffset(
        math.clamp(x, 6, math.max(6, bounds.X - 64)),
        math.clamp(y, 6, math.max(6, bounds.Y - 64))
    )
end

local function clampWindow(x, y)
    if windowAnimating then return end
    local bounds = surface.AbsoluteSize

    window.Position = UDim2.fromOffset(
        math.clamp(x, 0, math.max(0, bounds.X - 700 * scale.Scale)),
        math.clamp(y, 0, math.max(0, bounds.Y - 410 * scale.Scale))
    )
end

local function resize(center)
    if windowAnimating then return end
    local bounds = surface.AbsoluteSize
    if bounds.X < 1 or bounds.Y < 1 then return end

    scale.Scale = math.max(0.05, math.min(
        1,
        (bounds.X - 20) / 700,
        (bounds.Y - 20) / 410
    ))

    if center then
        clampWindow(
            (bounds.X - 700 * scale.Scale) / 2,
            (bounds.Y - 410 * scale.Scale) / 2
        )
    else
        clampWindow(
            window.Position.X.Offset,
            window.Position.Y.Offset
        )
    end

    clampLauncher(
        launcher.Position.X.Offset,
        launcher.Position.Y.Offset
    )
end

local launcherScale=make("UIScale",launcher,{Scale=1})
local function toggleMinimize()
    if windowAnimating or destroyed then return end
    windowAnimating=true
    local home=window.Position
    local duration=0.34
    local easing=TweenInfo.new(duration,Enum.EasingStyle.Quart,Enum.EasingDirection.InOut)
    local closing=not minimized
    local edges={}
    for _,child in ipairs(window:GetChildren()) do
        if child:IsA("UIStroke") then
            edges[#edges+1]={object=child,alpha=child.Transparency}
        end
    end
    if closing and not launcherPlaced then
        clampLauncher(home.X.Offset,home.Y.Offset)
        launcherPlaced=true
    end
    local shifted=UDim2.fromOffset(home.X.Offset,home.Y.Offset+16)
    if not closing then
        launcher.Visible=false
        window.Position=shifted
        window.GroupTransparency=1
        for _,entry in ipairs(edges) do entry.object.Transparency=1 end
        window.Visible=true
    end
    for _,entry in ipairs(edges) do
        TweenService:Create(entry.object,easing,{
            Transparency=closing and 1 or entry.alpha,
        }):Play()
    end
    local motion=TweenService:Create(window,easing,{
        Position=closing and shifted or home,
        GroupTransparency=closing and 1 or 0,
    })
    motion:Play()
    task.spawn(function()
        motion.Completed:Wait()
        if destroyed then return end
        if closing then window.Visible=false end
        window.Position=home
        for _,entry in ipairs(edges) do entry.object.Transparency=entry.alpha end
        minimized=closing
        windowAnimating=false
        if closing then
            launcherScale.Scale=0.85
            launcher.Visible=true
            TweenService:Create(launcherScale,TweenInfo.new(0.18,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),{Scale=1}):Play()
        end
        resize(false)
    end)
end

local function draggable(handle, target, clamp, onTap)
    local held, startPoint, startPosition
    local moved = false

    connect(handle.InputBegan, function(input)
        if held then return end

        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            held = input
            startPoint = input.Position
            startPosition = target.Position
            moved = false
        end
    end)

    connect(UIS.InputChanged, function(input)
        if not held then return end

        local mouse = held.UserInputType
            == Enum.UserInputType.MouseButton1

        if input == held
            or (mouse and input.UserInputType
                == Enum.UserInputType.MouseMovement) then

            local delta = input.Position - startPoint
            if delta.Magnitude > 8 then moved = true end

            if moved then
                clamp(
                    startPosition.X.Offset + delta.X,
                    startPosition.Y.Offset + delta.Y
                )
            end
        end
    end)

    connect(UIS.InputEnded, function(input)
        if input ~= held then return end

        local wasMoved = moved
            or (input.Position - startPoint).Magnitude > 8

        held = nil

        if onTap and not wasMoved then
            local point = input.Position
            local origin = handle.AbsolutePosition
            local size = handle.AbsoluteSize

            if point.X >= origin.X
                and point.X <= origin.X + size.X
                and point.Y >= origin.Y
                and point.Y <= origin.Y + size.Y then
                onTap()
            end
        end
    end)

    connect(UIS.WindowFocusReleased, function()
        held = nil
    end)
end

