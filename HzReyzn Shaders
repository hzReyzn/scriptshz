local function profile(overrides)
    local result = {}

    for group, props in pairs(BASE) do
        result[group] = {}
        for k, v in pairs(props) do
            result[group][k] = v
        end
    end

    for group, props in pairs(overrides or {}) do
        for k, v in pairs(props) do
            result[group][k] = v
        end
    end

    return result
end

