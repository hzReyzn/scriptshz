local terrainOverrides = {}
local function terrainDetails(on)
    for name,variant in pairs(variants) do
        local material = materialByName[name:lower()]
        pcall(function()
            if on then
                if terrainOverrides[material] == nil then
                    local original = MaterialService:GetBaseMaterialOverride(material)
                    -- Existing custom terrain colors/maps remain untouched.
                    if original == "" then
                        MaterialService:SetBaseMaterialOverride(material, variant.Name)
                        terrainOverrides[material] = {old=original, applied=variant.Name}
                    end
                end
            else
                local saved = terrainOverrides[material]
                if saved and MaterialService:GetBaseMaterialOverride(material) == saved.applied then
                    MaterialService:SetBaseMaterialOverride(material, saved.old)
                end
                terrainOverrides[material]=nil
            end
        end)
    end
end
