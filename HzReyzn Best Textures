local function characterPart(part)
    local p = part.Parent
    while p and p ~= workspace do
        if p:IsA("Model") and p:FindFirstChildOfClass("Humanoid") then return true end
        if p:IsA("Tool") or p:IsA("Accessory") then return true end
        p = p.Parent
    end
    return false
end
local function namedMaterial(part)
    local explicit = part:GetAttribute("HZMaterial")
    if type(explicit) == "string" and materialByName[explicit:lower()] then
        return materialByName[explicit:lower()]
    end
    -- Infer only bland default materials, never replace a real wood/metal/etc material.
    if part.Material ~= Enum.Material.Plastic and part.Material ~= Enum.Material.SmoothPlastic then
        return part.Material
    end
    local text = part.Name:gsub("(%l)(%u)", "%1 %2"):lower()
    local whole = materialByName[text:gsub("[%s_%-]", "")]
    if whole then return whole end
    local fallback
    for word in text:gmatch("%a+") do
        local name = aliases[word]
        local m = materialByName[word] or (name and materialByName[name:lower()])
        if m then
            if word == "wall" or word == "walls" or word == "floor" or word == "piso" or word == "pared" then
                fallback = m
            else return m end
        end
    end
    return fallback or part.Material
end
local function restore(part)
    local state = originals[part]
    if not state then return end
    if part.Parent then
        pcall(function()
            -- Avoid overwriting a newer material applied by the game.
            if part.MaterialVariant == state.appliedVariant and part.Material == state.appliedMaterial then
                part.Material = state.material
                part.MaterialVariant = state.variant
                part.Reflectance = state.reflectance
                part.CustomPhysicalProperties = state.physics
            end
        end)
    end
    originals[part] = nil
end
local function apply(part)
    if originals[part] or not part.Anchored or part.Transparency >= 0.98 or characterPart(part) then return end
    if part.MaterialVariant ~= "" or part:FindFirstChildOfClass("SurfaceAppearance") then return end
    if part:FindFirstChildOfClass("Texture") or part:FindFirstChildOfClass("Decal")
        or part:FindFirstChildOfClass("SpecialMesh") then return end
    if part:IsA("MeshPart") and part.TextureID ~= "" then return end
    local mat = namedMaterial(part)
    local variant = variants[mat.Name]
    local glass = mat == Enum.Material.Glass
    if not variant and not glass then return end
    local state = {material=part.Material, variant=part.MaterialVariant,
        reflectance=part.Reflectance, physics=part.CustomPhysicalProperties,
        appliedMaterial=mat, appliedVariant=variant and variant.Name or ""}
    originals[part] = state
    local ok = pcall(function()
        -- Freeze original physical properties before a visual material substitution.
        part.CustomPhysicalProperties = part.CurrentPhysicalProperties
        part.Material = mat
        part.MaterialVariant = state.appliedVariant
        if glass then part.Reflectance = math.max(part.Reflectance, 0.12) end
    end)
    if not ok then
        pcall(function()
            part.Material=state.material; part.MaterialVariant=state.variant
            part.Reflectance=state.reflectance; part.CustomPhysicalProperties=state.physics
        end)
        originals[part] = nil
    end
end
local function register(p)
    if p:IsA("BasePart") and not p:IsA("Terrain") and not indices[p] then
        parts[#parts + 1] = p; indices[p] = #parts
    end
end
