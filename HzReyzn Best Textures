local rayParams=RaycastParams.new()
rayParams.FilterType=Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide=true
local scanClock,stepClock,uiClock=0,0,0
local lastSurface="None"
connect(RunService.Heartbeat,function(dt)
    if not alive then return end
    if character and character.Parent then
        root=character:FindFirstChild("HumanoidRootPart");humanoid=character:FindFirstChildOfClass("Humanoid")
    else root=nil;humanoid=nil end
    scanClock=scanClock+dt;uiClock=uiClock+dt
    if scanClock>=CONFIG.ScanInterval then
        scanClock=0
        local camera=workspace.CurrentCamera
        local origin=root and root.Position or (camera and camera.CFrame.Position)
        if origin then
            for _=1,math.min(CONFIG.BatchSize,#parts) do
                if cursor>#parts then cursor=1 end
                local p=parts[cursor];cursor=cursor+1
                if p and p.Parent then
                    local near=(p.Position-origin).Magnitude <= CONFIG.Radius+p.Size.Magnitude*0.5
                    if enabled and near then apply(p) else restore(p) end
                end
            end
        end
    end
    if uiClock>=1 then
        uiClock=0
        local n=0;for _ in pairs(originals) do n=n+1 end
        status.Text=string.format("%d detailed parts  •  %d studs\nSurface: %s",n,CONFIG.Radius,lastSurface)
        local camera=workspace.CurrentCamera
        if camera then uiScale.Scale=math.min(1,(camera.ViewportSize.X-20)/300,(camera.ViewportSize.Y-50)/190) end
    end
    local walking=footsteps and root and humanoid and humanoid.Health>0 and not humanoid.SeatPart
        and humanoid.FloorMaterial~=Enum.Material.Air and humanoid.MoveDirection.Magnitude>0.05
        and humanoid:GetState()~=Enum.HumanoidStateType.Swimming
        and humanoid:GetState()~=Enum.HumanoidStateType.Climbing
    if not walking then
        stepClock=0;unmute();if stepSound then stepSound:Stop() end;return
    end
    if not stepSound or stepSound.Parent~=root then
        clearSound()
        stepSound=make("Sound",root,{Name="HZSurfaceStep",SoundId="rbxasset://sounds/action_footsteps_plastic.mp3",
            Volume=CONFIG.Volume,Looped=false,RollOffMaxDistance=30})
        eq=make("EqualizerSoundEffect",stepSound,{})
        reverb=make("ReverbSoundEffect",stepSound,{DecayTime=0.3,Density=0.3,Diffusion=0.4,WetLevel=-25})
    end
    -- Only suppress legacy default footsteps after the replacement has loaded.
    if stepSound.IsLoaded then
        local running=root:FindFirstChild("Running")
        if running and running:IsA("Sound") then
            if mutedRunning[running]==nil then mutedRunning[running]=running.Volume end
            running.Volume=0
        end
    else unmute() end
    stepClock=stepClock+dt
    local speed=Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z).Magnitude
    if speed<1 then return end
    local interval=math.clamp(5/math.max(speed,1),0.19,0.65)
    if stepClock<interval then return end
    stepClock=0
    rayParams.FilterDescendantsInstances={character}
    local hit=workspace:Raycast(root.Position,Vector3.new(0,-(humanoid.HipHeight+root.Size.Y*0.5+4),0),rayParams)
    local mat=hit and hit.Material or humanoid.FloorMaterial
    if hit and hit.Instance:IsA("BasePart") and not hit.Instance:IsA("Terrain") then mat=namedMaterial(hit.Instance) end
    lastSurface=mat.Name
    local category=byMaterial[mat] or "Hard"
    local p=profiles[category]
    local id=CONFIG.SoundIds[mat.Name] or CONFIG.SoundIds[category] or "rbxasset://sounds/action_footsteps_plastic.mp3"
    if stepSound.SoundId~=id then stepSound:Stop();stepSound.SoundId=id end
    stepSound.PlaybackSpeed=p[1]*(0.96+math.random()*0.08)
    stepSound.Volume=CONFIG.Volume*(category=="Soft" and 0.55 or 1)
    eq.LowGain=p[2];eq.MidGain=p[3];eq.HighGain=p[4]
    reverb.WetLevel=p[5]>0 and (-30+p[5]*60) or -80
    stepSound.TimePosition=0;stepSound:Play()
end)
