-- Startup errors are displayed on screen for mobile troubleshooting.
local function reportError(message)
    warn("[HzReyzn Best Textures] " .. tostring(message))
    pcall(function()
        local p = game:GetService("Players").LocalPlayer
        if not p then return end
        local pg = p:FindFirstChild("PlayerGui")
        if not pg then return end
        local old = pg:FindFirstChild("HZTexturesError")
        if old then old:Destroy() end
        local g = Instance.new("ScreenGui")
        g.Name = "HZTexturesError"
        g.DisplayOrder = 100
        g.ResetOnSpawn = false
        local t = Instance.new("TextButton")
        t.Size = UDim2.new(0.9, 0, 0, 150)
        t.Position = UDim2.new(0.05, 0, 0.1, 0)
        t.BackgroundColor3 = Color3.fromRGB(28, 18, 22)
        t.TextColor3 = Color3.new(1, 1, 1)
        t.TextSize = 14
        t.TextWrapped = true
        t.Text = "HzReyzn Best Textures — error\n" .. tostring(message) .. "\nTap to close"
        t.Parent = g
        g.Parent = pg
        t.Activated:Connect(function() g:Destroy() end)
    end)
end
local startupOK, startupError = xpcall(function()
-- HzReyzn Best Textures | mobile recovery / light environment controls.
-- Removes the previous UI first so its cleanup restores its material overrides.
-- Does not replace or upscale textures. Preserves native map detail and colors.
-- No workspace scans, material assets, terrain overrides or per-frame callbacks.
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local player = Players.LocalPlayer
if not player then error("Run this script on the client after joining a game.") end
local pg = player:WaitForChild("PlayerGui", 15)
if not pg then error("PlayerGui was not available after 15 seconds.") end
local old = pg:FindFirstChild("HZBestTextures")
if old then old:Destroy() end
local alive = true
local Lighting = game:GetService("Lighting")
local terrain = workspace.Terrain
local waterEnabled, skyEnabled = false, false
local connections = {}
local function connect(signal, fn)
    local c = signal:Connect(fn)
    connections[#connections + 1] = c
    return c
end
local function make(class, parent, props)
    local o = Instance.new(class)
    for k,v in pairs(props or {}) do o[k] = v end
    o.Parent = parent
    return o
end
local function corner(o, radius)
    make("UICorner", o, {CornerRadius = UDim.new(0, radius or 10)})
end
local gui = make("ScreenGui", pg, {Name="HZBestTextures", ResetOnSpawn=false, DisplayOrder=32})
local frame = make("Frame", gui, {Size=UDim2.fromOffset(300,236), Position=UDim2.new(0.5,-150,0.15,0),
    BackgroundColor3=Color3.fromRGB(8,20,36), BorderSizePixel=0})
corner(frame,14)
make("UIStroke",frame,{Color=Color3.fromRGB(75,215,235),Thickness=1.5})
local uiScale=make("UIScale",frame,{Scale=1})
local title=make("TextLabel",frame,{Active=true,Text="HzReyzn Best Textures",Size=UDim2.new(1,-75,0,44),
    Position=UDim2.fromOffset(12,0),BackgroundTransparency=1,TextColor3=Color3.new(1,1,1),TextSize=15,Font=Enum.Font.GothamBold})
local function uiButton(text,x,y,w)
    local b=make("TextButton",frame,{Text=text,Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,36),
        BackgroundColor3=Color3.fromRGB(17,48,70),TextColor3=Color3.fromRGB(140,240,250),
        TextSize=13,Font=Enum.Font.GothamMedium,BorderSizePixel=0})
    corner(b,8); return b
end
local close=uiButton("×",262,5,30)
local mini=uiButton("−",228,5,30)
local textureButton=make("TextLabel",frame,{
    Text="Original textures • native materials",Position=UDim2.fromOffset(12,52),
    Size=UDim2.fromOffset(276,36),BackgroundTransparency=1,
    TextColor3=Color3.fromRGB(140,240,250),TextSize=13,Font=Enum.Font.GothamMedium,
})
local waterButton=uiButton("Water: OFF",12,94,276)
local skyButton=uiButton("Sky & clouds: OFF",12,136,276)
local status=make("TextLabel",frame,{Text="Light mode: no material replacements.\nWater and sky are optional.",Position=UDim2.fromOffset(12,181),Size=UDim2.fromOffset(276,40),
    BackgroundTransparency=1,TextColor3=Color3.fromRGB(174,203,214),TextSize=11,TextWrapped=true,Font=Enum.Font.GothamMedium})

-- All environment changes are reversible; never write WaterColor or terrain material colors.
local waterOriginal = {}
local waterSettings = {WaterWaveSize=0.18, WaterWaveSpeed=8, WaterReflectance=0.65, WaterTransparency=0.3}
local function setWater(on)
    if on == waterEnabled then return end
    if on then
        for k,v in pairs(waterSettings) do
            waterOriginal[k] = terrain[k]
            terrain[k] = v
        end
    else
        for k,v in pairs(waterOriginal) do
            if terrain[k] == waterSettings[k] then terrain[k] = v end
        end
        table.clear(waterOriginal)
    end
    waterEnabled = on
    waterButton.Text = on and "Water: ON" or "Water: OFF"
end
local savedSkies, savedClouds = {}, {}
local ownSky, ownClouds, oldWind
local wind = Vector3.new(4, 0, 2)
local function setSky(on)
    if on == skyEnabled then return end
    if on then
        skyEnabled = true -- Allows cleanup even if an environment property is unavailable.
        for _,o in ipairs(Lighting:GetChildren()) do
            if o:IsA("Sky") then savedSkies[#savedSkies+1]=o; o.Parent=nil end
        end
        for _,o in ipairs(terrain:GetChildren()) do
            if o:IsA("Clouds") then savedClouds[#savedClouds+1]=o; o.Parent=nil end
        end
        ownSky = make("Sky", Lighting, {
            Name="HZClearSky", CelestialBodiesShown=true,
            SunAngularSize=11, MoonAngularSize=10, StarCount=1800,
            SkyboxBk="rbxasset://textures/sky/sky512_bk.tex",
            SkyboxDn="rbxasset://textures/sky/sky512_dn.tex",
            SkyboxFt="rbxasset://textures/sky/sky512_ft.tex",
            SkyboxLf="rbxasset://textures/sky/sky512_lf.tex",
            SkyboxRt="rbxasset://textures/sky/sky512_rt.tex",
            SkyboxUp="rbxasset://textures/sky/sky512_up.tex",
        })
        ownClouds = make("Clouds", terrain, {
            Name="HZSoftClouds", Cover=0.55, Density=0.32,
            Color=Color3.new(1,1,1), Enabled=true,
        })
        oldWind = workspace.GlobalWind
        workspace.GlobalWind = wind
    else
        if ownSky then ownSky:Destroy(); ownSky=nil end
        if ownClouds then ownClouds:Destroy(); ownClouds=nil end
        for _,o in ipairs(savedSkies) do pcall(function() if not o.Parent then o.Parent=Lighting end end) end
        for _,o in ipairs(savedClouds) do pcall(function() if not o.Parent then o.Parent=terrain end end) end
        table.clear(savedSkies); table.clear(savedClouds)
        if oldWind and workspace.GlobalWind == wind then workspace.GlobalWind=oldWind end
        oldWind=nil
    end
    skyEnabled=on
    skyButton.Text=on and "Sky & clouds: ON" or "Sky & clouds: OFF"
end
connect(waterButton.Activated,function() setWater(not waterEnabled) end)
connect(skyButton.Activated,function()
    local ok, err = pcall(function() setSky(not skyEnabled) end)
    if not ok then
        pcall(function() setSky(false) end)
        status.Text = "Sky unavailable on this client."
        warn("[HZ Sky] " .. tostring(err))
    end
end)

local function resizePanel()
    local camera=workspace.CurrentCamera
    if not camera then return end
    uiScale.Scale=math.max(0.1,math.min(1,(camera.ViewportSize.X-20)/300,(camera.ViewportSize.Y-50)/236))
end
local viewportConnection
local function bindCamera()
    if viewportConnection then viewportConnection:Disconnect() end
    local camera=workspace.CurrentCamera
    if camera then viewportConnection=connect(camera:GetPropertyChangedSignal("ViewportSize"),resizePanel) end
    resizePanel()
end
connect(workspace:GetPropertyChangedSignal("CurrentCamera"),bindCamera)
bindCamera()
local minimized=false
connect(mini.Activated,function()
    minimized=not minimized
    textureButton.Visible=not minimized; waterButton.Visible=not minimized; skyButton.Visible=not minimized; status.Visible=not minimized
    frame.Size=UDim2.fromOffset(300,minimized and 46 or 236);mini.Text=minimized and "+" or "−"
end)
local held,startPoint,startPosition
connect(title.InputBegan,function(input)
    if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
        held=input; startPoint=input.Position; startPosition=frame.Position
    end
end)
local function clampPanel(x,y)
    local view=workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800,600)
    frame.Position=UDim2.fromOffset(math.clamp(x,0,math.max(0,view.X-300*uiScale.Scale)),
        math.clamp(y,0,math.max(0,view.Y-270*uiScale.Scale)))
end
connect(UIS.InputChanged,function(input)
    if held and (input==held or (held.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseMovement)) then
        local d=input.Position-startPoint
        local view=workspace.CurrentCamera.ViewportSize
        clampPanel(startPosition.X.Scale*view.X+startPosition.X.Offset+d.X,startPosition.Y.Scale*view.Y+startPosition.Y.Offset+d.Y)
    end
end)
connect(UIS.InputEnded,function(input) if input==held then held=nil end end)
connect(UIS.WindowFocusReleased,function() held=nil end)
connect(gui.Destroying,function()
    if not alive then return end
    alive=false
    for _,c in ipairs(connections) do c:Disconnect() end
    setWater(false)
    setSky(false)
end)
connect(close.Activated,function() gui:Destroy() end)

end, function(err) return debug.traceback(tostring(err), 2) end)
if not startupOK then reportError(startupError) end
