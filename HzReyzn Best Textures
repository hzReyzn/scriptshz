local function restore(part)
    local state = originals[part]
    if not state then return end
    if part.Parent then
        pcall(function()
            -- Avoid overwriting a newer material applied by the game.
            if part.MaterialVariant == state.appliedVariant and part.Material == state.appliedMaterial then
                part.MaterialVariant = state.variant
                part.Reflectance = state.reflectance
            end
        end)
    end
    originals[part] = nil
end
local function apply(part)
    if originals[part] or part.Transparency >= 0.98 or characterPart(part) then return end
    if part.MaterialVariant ~= "" or part:FindFirstChildOfClass("SurfaceAppearance") then return end
    if part:FindFirstChildOfClass("Texture") or part:FindFirstChildOfClass("Decal")
        or part:FindFirstChildOfClass("SpecialMesh") then return end
    if part:IsA("MeshPart") and part.TextureID ~= "" then return end
    local mat = part.Material
    local variant = variants[mat.Name]
    local glass = mat == Enum.Material.Glass
    if not variant and not glass and mat == part.Material then return end
    local state = {material=part.Material, variant=part.MaterialVariant,
        reflectance=part.Reflectance, physics=part.CustomPhysicalProperties,
        appliedMaterial=mat, appliedVariant=variant and variant.Name or ""}
    originals[part] = state
    local ok = pcall(function()
        part.MaterialVariant = state.appliedVariant
        if glass then part.Reflectance = math.max(part.Reflectance, 0.12) end
    end)
