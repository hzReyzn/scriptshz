Player.CharacterAdded:Connect(function(Character)

	-- Remember previous state
	local WasEnabled = Enabled

	-- Temporarily pause telekinesis
	Enabled = false

	Clock = 0
	ScanClock = 0

	ReleaseEverything()

	local PlayerRoot =
		Character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not PlayerRoot then

		Toggle.Text = "Enable"

		Status.BackgroundColor3 =
			Color3.fromRGB(125,30,30)

		return
	end

	task.wait(0.5)

	RefreshCache()

	CacheIndex = 1
	ScanClock = Settings.ScanInterval

	-- Reapply collision preference after respawn
	ApplyCollisionMode()

	-- Restore telekinesis state
	Enabled = WasEnabled

	if Enabled then

		Toggle.Text = "Disable"

		Status.BackgroundColor3 =
			Color3.fromRGB(40,175,55)

	else

		Toggle.Text = "Enable"

		Status.BackgroundColor3 =
			Color3.fromRGB(125,30,30)

	end

	-- UI ONLY
	ApplyTheme(Settings.Theme)
	ApplyUITransparency()
end)

