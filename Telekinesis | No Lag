local function BelongsToCharacter(Part)

	local Model =
		Part:FindFirstAncestorOfClass("Model")

	if Model
		and Model:FindFirstChildOfClass("Humanoid")
	then

		return true
	end

	return false
end

local function IsSpecialPart(Part)

	if not Part then
		return false
	end

	return Part.Name == "VolcanoPart"
		or Part.Name == "AvalanchePart"
end

--========================================================
-- COLLISION SYSTEM
--========================================================

local function DisablePartCollision(Part)

	if not Part
		or not Part.Parent
		or not Part:IsA("BasePart")
	then
		return
	end

	if Part.Anchored then
		return
	end

	local Character = Player.Character

	if Character and Part:IsDescendantOf(Character) then
		return
	end

	if BelongsToCharacter(Part) then
		return
	end

	if OriginalCollision[Part] == nil then
		OriginalCollision[Part] = Part.CanCollide
	end

	Part.CanCollide = false
end

local function DisableAllCollision()

	for _,Object in ipairs(workspace:GetDescendants()) do

		if Object:IsA("BasePart")
			and not Object.Anchored
		then

			DisablePartCollision(Object)
		end
	end
end

local function RestoreCollision()

	for Part,OriginalValue in pairs(OriginalCollision) do

		if Part and Part.Parent then
			Part.CanCollide = OriginalValue
		end
	end

	table.clear(OriginalCollision)
end

local function ApplyCollisionMode()

	if Settings.Collision then
		RestoreCollision()
	else
		DisableAllCollision()
	end
end

CollisionButton.Activated:Connect(function()

	Settings.Collision = not Settings.Collision

	if Settings.Collision then

		CollisionButton.Text = "Collision: ON"
		RestoreCollision()

	else

		CollisionButton.Text = "Collision: OFF"
		DisableAllCollision()

	end
end)

-- Handle newly created unanchored parts
workspace.DescendantAdded:Connect(function(Object)

	if Settings.Collision then
		return
	end

	if not Object:IsA("BasePart") then
		return
	end

	task.defer(function()

		if Object.Parent and not Object.Anchored then
			DisablePartCollision(Object)
		end
	end)
end)

--========================================================
-- ADD OBJECT
--========================================================

local function AddObject(Part)

	if not Part
		or not Part.Parent
		or not Part:IsA("BasePart")
	then
		return false
	end

	local Special = IsSpecialPart(Part)

	if Part.Anchored and not Special then
		return false
	end

	local Character = Player.Character

	if Character and Part:IsDescendantOf(Character) then
		return false
	end

	if BelongsToCharacter(Part) then
		return false
	end

	local Root =
		Part.AssemblyRootPart or Part

	if not Root or not Root.Parent then
		return false
	end

	if Objects[Root] then
		return false
	end

	if Root.Anchored and not Special then
		return false
	end

	if Character and Root:IsDescendantOf(Character) then
		return false
	end

	if BelongsToCharacter(Root) then
		return false
	end

	local Attachment =
		Instance.new("Attachment")

	Attachment.Name = "TelekinesisAttachment"
	Attachment.Parent = Root

	local Align =
		Instance.new("AlignPosition")

	Align.Name = "TelekinesisPosition"
	Align.Mode = Enum.PositionAlignmentMode.OneAttachment
	Align.Attachment0 = Attachment
	Align.ApplyAtCenterOfMass = true
	Align.MaxForce = math.huge
	Align.MaxVelocity = math.huge
	Align.Responsiveness = 500
	Align.RigidityEnabled = false
	Align.Parent = Root

	Objects[Root] = {

		Attachment = Attachment,
		Align = Align,

		Special = Special,

		Angle =
			math.random()
			* math.pi
			* 2,

		HeightSeed =
			math.random(),

		RadiusSeed =
			math.random(),

		Speed =
			math.random(80,135)
			/ 100,

		SpinDirection =
			math.random(0,1) == 1
			and 1
			or -1
	}

	return true
end

--========================================================
-- REMOVE / RELEASE
--========================================================

local function RemoveObject(Root)

	local Data = Objects[Root]

	if not Data then
		return
	end

	if Data.Align then
		Data.Align:Destroy()
	end

	if Data.Attachment then
		Data.Attachment:Destroy()
	end

	Objects[Root] = nil
end

local function ReleaseEverything()

	local List = {}

	for Root in pairs(Objects) do
		table.insert(List,Root)
	end

	for _,Root in ipairs(List) do
		RemoveObject(Root)
	end
end

local function ObjectCount()

	local Amount = 0

	for _ in pairs(Objects) do
		Amount += 1
	end

	return Amount
end

local function EnforceBlockLimit()

	local Amount = ObjectCount()

	if Amount <= Settings.Blocks then
		return
	end

	local Extra =
		Amount - Settings.Blocks

	for Root in pairs(Objects) do

		if Extra <= 0 then
			break
		end

		RemoveObject(Root)

		Extra -= 1
	end
end

--========================================================
-- CACHE
--========================================================

local function RefreshCache()

	CachedParts =
		workspace:GetDescendants()

	CacheIndex = 1
end

RefreshCache()

--========================================================
-- GLOBAL SCAN
--========================================================

local function ScanGlobal()

	local Amount = ObjectCount()

	if Amount >= Settings.Blocks then
		return
	end

	if CacheIndex > #CachedParts then
		RefreshCache()
	end

	local Processed = 0
	local ChunkSize = 750

	while CacheIndex <= #CachedParts
		and Processed < ChunkSize
	do

		if Amount >= Settings.Blocks then
			break
		end

		local Object =
			CachedParts[CacheIndex]

		CacheIndex += 1
		Processed += 1

		if Object
			and Object.Parent
			and Object:IsA("BasePart")
			and (
				not Object.Anchored
				or IsSpecialPart(Object)
			)
		then

			if AddObject(Object) then
				Amount += 1
			end
		end
	end
end
end)
