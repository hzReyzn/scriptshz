--========================================================
-- MAIN TELEKINESIS
-- ORIGINAL PHYSICS
--========================================================

RunService.Heartbeat:Connect(function(DT)

	if not Enabled then
		return
	end

	local Character = Player.Character

	if not Character then
		return
	end

	local PlayerRoot =
		Character:FindFirstChild("HumanoidRootPart")

	if not PlayerRoot then
		return
	end

	Clock += DT * Settings.OrbitSpeed
	ScanClock += DT

	EnforceBlockLimit()

	if ScanClock >= Settings.ScanInterval then

		ScanClock = 0
		ScanGlobal()
	end

	local Index = 0

	for Root,Data in pairs(Objects) do

		if not Root or not Root.Parent then

			RemoveObject(Root)
			continue
		end

		if Root.Anchored and not Data.Special then

			RemoveObject(Root)
			continue
		end

		Index += 1

		local Angle =
			Clock * Data.Speed
			+ Data.Angle
			+ Index * 0.28

		local Vertical =
			(
				Data.HeightSeed
				* Settings.Height
				+ Clock * 2.4
			)
			% Settings.Height

		local HeightRatio =
			Vertical / Settings.Height

		local Radius =
			Settings.Distance
			+ Data.RadiusSeed * 3
			+ HeightRatio * 4

		local X =
			math.cos(Angle) * Radius

		local Z =
			math.sin(Angle) * Radius

		local Target =
			PlayerRoot.Position
			+ Vector3.new(
				X,
				2.5 + Vertical,
				Z
			)

		if Data.Align and Data.Align.Parent then
			Data.Align.Position = Target
		end

		if not Root.Anchored then

			local Offset =
				Target - Root.Position

			local Distance =
				Offset.Magnitude

			if Distance > 0.05 then

				local Speed =
					math.min(
						Settings.PullSpeed
							+ Distance * 7,
						Settings.MaxPullSpeed
					)

				local DesiredVelocity =
					Offset.Unit * Speed

				local Alpha =
					math.clamp(
						DT * Settings.PullAcceleration,
						0,
						1
					)

				Root.AssemblyLinearVelocity =
					Root.AssemblyLinearVelocity:Lerp(
						DesiredVelocity,
						Alpha
					)
			end

			Root.AssemblyAngularVelocity =
				Vector3.new(
					2.5,
					Settings.SpinSpeed
						* Data.SpinDirection,
					1.5
				)
		end
	end
end)

