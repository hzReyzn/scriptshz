local function Darken(Color,Amount)

	return Color3.new(
		Color.R * Amount,
		Color.G * Amount,
		Color.B * Amount
	)
end

--========================================================
-- TRANSPARENCY
-- UI ONLY
--========================================================

local function ApplyUITransparency()

	local Amount =
		math.clamp(
			Settings.UITransparency,
			0,
			0.90
		)

	for _,Object in ipairs(TransparentObjects) do

		if Object and Object.Parent then
			Object.BackgroundTransparency = Amount
		end
	end

	-- Text stays fully visible.
	-- Status stays easy to read.
	Status.BackgroundTransparency = 0.1

	TransparencyValue.Text =
		tostring(
			math.round(Amount * 100)
		) .. "%"
end

--========================================================
-- APPLY THEME
-- UI ONLY
--========================================================

local function ApplyTheme(Name,RGBColor)

	local Theme

	if Name == "RGB" then

		local Main =
			RGBColor
			or Color3.fromHSV(
				RGBHue,
				1,
				1
			)

		Theme = {
			Window = Darken(Main,0.35),
			Button = Darken(Main,0.55),
			Value = Darken(Main,0.75),
			Accent = Main,
			Border = Darken(Main,0.20),
			Text = Color3.fromRGB(255,255,255),
			AccentText = Color3.fromRGB(255,255,255),
		}

	else

		Theme = Themes[Name]
	end

	if not Theme then
		return
	end

	Window.BackgroundColor3 = Theme.Window
	Window.BorderColor3 = Theme.Border

	TopBar.BackgroundColor3 = Theme.Accent
	TopBar.BorderColor3 = Theme.Border

	Title.TextColor3 = Theme.AccentText

	SettingsButton.BackgroundColor3 = Theme.Button
	SettingsButton.BorderColor3 = Theme.Border
	SettingsButton.TextColor3 = Theme.Text

	Toggle.BackgroundColor3 = Theme.Button
	Toggle.BorderColor3 = Theme.Border
	Toggle.TextColor3 = Theme.Text

	for _,Button in ipairs(ThemeButtons) do

		Button.BackgroundColor3 = Theme.Button
		Button.BorderColor3 = Theme.Border
		Button.TextColor3 = Theme.Text
	end

	for _,Label in ipairs(ThemeLabels) do
		Label.TextColor3 = Theme.Text
	end

	for _,Value in ipairs(ThemeValues) do

		Value.BackgroundColor3 = Theme.Value
		Value.BorderColor3 = Theme.Border
		Value.TextColor3 = Theme.Text
	end

	ThemeButton.Text =
		"Theme: "
		.. ThemeNames[Name]

	ApplyUITransparency()
end

